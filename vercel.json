{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,backups/**,uploads/**,tests/**,work/**,**/*.db,**/*.db-*,**/*.sqlite*,**/*.xlsx,**/*.xls,**/*.csv,**/*.zip,IMPORT-NOTES.json,.env,.env.*,__pycache__/**}"
    }
  }
}
