# Set these in Vercel Project Settings > Environment Variables.
# DATABASE_URL must point to a dedicated PostgreSQL database. Do not use SQLite.
DATABASE_URL=
# Final HTTPS origin, with no trailing slash, e.g. https://your-project.vercel.app
APP_ORIGIN=
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required to claim the first Owner account. Remove it after creating the Owner.
YUNA_SETUP_TOKEN=
# Only needed when testing cloud behavior outside Vercel:
# YUNA_CLOUD=1
